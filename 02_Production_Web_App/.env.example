# ==========================================
# APEX LOAN SYSTEMS - ENVIRONMENT VARIABLES
# ==========================================

# 1. DATABASE CONFIGURATION
# If left blank, it will default to a local SQLite database file.
# For production, paste your PostgreSQL connection string here.
DATABASE_URL=postgresql://user:password@host:port/database

# 2. SECURITY CONFIGURATION
# Change this to a long, random string in production! 
# You can generate one by running `openssl rand -hex 32` in your terminal.
SECRET_KEY=super-secret-key-change-this-in-production
